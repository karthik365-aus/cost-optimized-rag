OPENAI_API_KEY=your-openai-api-key-here

# Local OpenAI-compatible endpoint (LM Studio / Ollama OpenAI proxy)
LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1
LOCAL_OPENAI_API_KEY=lm-studio

# Router model mapping
# Use exact IDs exposed by your local /v1/models endpoint.
LOCAL_SIMPLE_MODEL=tinyllama-1.1b-chat-v1.0
LOCAL_MEDIUM_MODEL=mistralai/ministral-3-3b
OPENAI_COMPLEX_MODEL=gpt-4o-mini


# Context compression (hybrid TF-IDF + local embeddings, same family as retrieval by default)
COMPRESSION_USE_EMBEDDINGS=true
COMPRESSION_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COMPRESSION_ADAPTIVE_BUDGET=true
COMPRESSION_REDUNDANCY_THRESHOLD=0.85

# Optional: embedding model for evaluate.py answer-vs-ground-truth similarity (defaults to BGE small)
EVAL_GT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
